# Required for server-side LLM demos (LLM Router, Portfolio Assistant, Multi-Agent, MCP, Edge Agent, STORM, Generative UI)
GROQ_API_KEY=your_groq_api_key_here

# Required in production for rate limiting, pending approvals, and daily spend caps
# (falls back to an in-memory store in dev)
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Required in production: signs agent credentials (auth.md demo). Without it, production
# fails closed (503) instead of signing with the public dev secret. Generate: openssl rand -hex 32
AGENT_AUTH_SECRET=your_random_secret_here

# Optional: daily LLM call caps (defaults: 500 per route, 60 per client across routes)
DAILY_LLM_CALL_CAP=500
DAILY_LLM_CALLS_PER_CLIENT=60

# Optional
ANTHROPIC_API_KEY=your_anthropic_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
